{
  "name": "topicgym-backend",
  "version": "0.1.0",
  "private": true,
  "description": "TopicGym v1.0 · Backend inicial (piloto Lógica de Programación) · Node.js + Express + PostgreSQL",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node seed.js",
    "db:schema": "psql -U postgres -d topicgym -f ../database/schema.sql",
    "db:seed": "psql -U postgres -d topicgym -f ../database/seed.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^9.14.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
