# ============================================================================
#  TopicGym Backend · Variables de entorno (copiar a .env y completar)
#  NUNCA subir el archivo .env real al repositorio.
# ============================================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (instalación local) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambia_esta_clave
DB_NAME=topicgym
DB_POOL_MAX=10

# --- JWT ---
JWT_SECRET=cambia_este_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1h

# --- CORS (lista separada por comas de orígenes permitidos) ---
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:5500,http://127.0.0.1:5500

# --- Rate limit global en /api (Compromiso 04 · Acta 06) ---
API_RATE_MAX=300
API_RATE_WINDOW_MS=600000

# --- Rate limit en /auth (más estricto) ---
AUTH_RATE_MAX=10
AUTH_RATE_WINDOW_MS=600000

# --- Email (verificación de registro) ---
# Ethereal (gratis, temporal): https://ethereal.email  ->  crear cuenta y pegar user/pass
# Mailtrap: https://mailtrap.io  ->  host=smtp.mailtrap.io, port=2525, secure=false
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="TopicGym <no-reply@topicgym.local>"

# --- URL base para el enlace de verificación (frontend) ---
APP_BASE_URL=http://localhost:4200

# --- OAuth 2.0 (SSO alternativo) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
