# ============================================================================
#  TopicGym Backend · Variables de entorno (copiar a .env y completar)
#  NUNCA subir el archivo .env real al repositorio.
# ============================================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (instalación local) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambia_esta_clave
DB_NAME=topicgym
DB_POOL_MAX=10

# --- JWT ---
JWT_SECRET=cambia_este_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1h

# --- CORS (lista separada por comas de orígenes permitidos) ---
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:5500,http://127.0.0.1:5500

# --- Rate limit en /auth ---
AUTH_RATE_MAX=10
AUTH_RATE_WINDOW_MS=600000

# --- OAuth 2.0 (SSO alternativo) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
